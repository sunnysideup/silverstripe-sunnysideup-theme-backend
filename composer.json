{
  "name": "sunnysideup/sunnysideup-theme-backend",
  "type": "silverstripe-vendormodule",
  "description": "Supporting module for the Sunny Side Up Theme.",
  "keywords": [
    "Silverstripe-CMS",
    "CMS",
    "Silverstripe",
    "Sunny Side Up",
    "Theme"
  ],
  "require": {
    "php": ">=8.1",
    "silverstripe/cms": "^4.0 || ^5.0",
    "silverstripe/userforms": "^5.0 || ^6.0",
    "sunnysideup/googleanalyticsbasics": "^5.0-dev",
    "sunnysideup/metatags": "^5.0-dev",
    "sunnysideup/webpack_requirements_backend": "^5.0-dev",
    "sunnysideup/simple-template-caching": "^5.0-dev",
    "sunnysideup/sunnysideup-theme": "^5.0-dev",
    "sunnysideup/phone_field": "^5.0-dev",
    "sunnysideup/email_address_database_field": "^5.0-dev",
    "sunnysideup/silverstripe-verbosefields": "^5.0-dev"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "sunnysideup/templateoverview": "^5.0-dev",
    "sunnysideup/prettyphoto": "^5.0-dev",
    "sunnysideup/typography": "^5.0-dev",
    "sunnysideup/sswebpack_engine_only": "^5.0-dev",
    "sunnysideup/config_manager": "^5.0-dev"
  },
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Nicolaas Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Sunnysideup\\SunnysideupThemeBackend\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "images"
    ]
  }
}
